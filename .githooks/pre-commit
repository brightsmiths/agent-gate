#!/usr/bin/env bash
# .githooks/pre-commit
#
# Enforces the .agentgate.toml quality gate pipeline on every commit.
# This is the backstop that catches violations regardless of whether
# the agent respected its path restrictions.
#
# Install: git config core.hooksPath .githooks
#
# Reads AGENTGATE_MODE from the environment to determine which paths
# are allowed. If AGENTGATE_MODE is not set, only the quality checks
# run (no path restriction enforcement).

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Find .agentgate.toml
find_config() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/.agentgate.toml" ]; then
            echo "$dir/.agentgate.toml"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

CONFIG_FILE=$(find_config) || {
    echo -e "${YELLOW}Warning: No .agentgate.toml found. Skipping agentgate checks.${NC}"
    exit 0
}

CONFIG_DIR=$(dirname "$CONFIG_FILE")
MODE="${AGENTGATE_MODE:-}"

echo "━━━ agentgate pre-commit checks ━━━"
[ -n "$MODE" ] && echo "Mode: $MODE"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No staged files. Nothing to check.${NC}"
    exit 0
fi

ERRORS=0

# ─────────────────────────────────────────────────────────────────────
# CHECK 1: Path restrictions (only if AGENTGATE_MODE is set)
# ─────────────────────────────────────────────────────────────────────

if [ -n "$MODE" ]; then
    echo -n "Check: path restrictions ($MODE)... "

    VIOLATIONS=""
    while IFS= read -r file; do
        if ! bash "$CONFIG_DIR/scripts/agentgate-check-path.sh" "$file" 2>/dev/null; then
            VIOLATIONS="${VIOLATIONS}\n  - $file"
        fi
    done <<< "$STAGED_FILES"

    if [ -n "$VIOLATIONS" ]; then
        echo -e "${RED}FAIL${NC}"
        echo -e "  Files outside writable paths for mode '$MODE':${VIOLATIONS}"
        echo "  Action: Remove these files from the commit, or switch to the correct agent mode."
        ERRORS=$((ERRORS + 1))
    else
        echo -e "${GREEN}OK${NC}"
    fi
fi

# ─────────────────────────────────────────────────────────────────────
# CHECK 2: Formatting (cargo fmt)
# ─────────────────────────────────────────────────────────────────────

# Only check if Rust files are staged
RUST_FILES=$(echo "$STAGED_FILES" | grep '\.rs$' || true)

if [ -n "$RUST_FILES" ]; then
    echo -n "Check: formatting (cargo fmt)... "
    if cargo fmt --check > /dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}FAIL${NC}"
        echo "  Action: Run 'cargo fmt' to fix formatting, then re-stage the files."
        ERRORS=$((ERRORS + 1))
    fi
fi

# ─────────────────────────────────────────────────────────────────────
# CHECK 3: No stubs (pattern scan)
# ─────────────────────────────────────────────────────────────────────

if [ -n "$RUST_FILES" ]; then
    echo -n "Check: no stubs... "

    # Patterns from .agentgate.toml [checks.no-stubs]
    STUB_PATTERNS=(
        'todo!()'
        'unimplemented!()'
        'panic!("not implemented")'
        '// TODO'
        '// FIXME'
        '// HACK'
        '// XXX'
    )

    STUB_HITS=""
    for pattern in "${STUB_PATTERNS[@]}"; do
        # Search staged content (not working tree) for stub patterns
        while IFS= read -r file; do
            MATCHES=$(git show ":$file" 2>/dev/null | grep -n -F "$pattern" || true)
            if [ -n "$MATCHES" ]; then
                while IFS= read -r match; do
                    STUB_HITS="${STUB_HITS}\n  - $file:$match"
                done <<< "$MATCHES"
            fi
        done <<< "$RUST_FILES"
    done

    if [ -n "$STUB_HITS" ]; then
        echo -e "${RED}FAIL${NC}"
        echo -e "  Stub markers found in staged files:${STUB_HITS}"
        echo "  Action: Replace all stub markers with actual implementations before committing."
        ERRORS=$((ERRORS + 1))
    else
        echo -e "${GREEN}OK${NC}"
    fi
fi

# ─────────────────────────────────────────────────────────────────────
# CHECK 4: Clippy (only for coder mode or unset mode)
# ─────────────────────────────────────────────────────────────────────

if [ -n "$RUST_FILES" ] && { [ -z "$MODE" ] || [ "$MODE" = "coder" ]; }; then
    echo -n "Check: clippy... "
    CLIPPY_OUTPUT=$(cargo clippy -- -D warnings 2>&1 | tail -30) || {
        echo -e "${RED}FAIL${NC}"
        echo "  $CLIPPY_OUTPUT"
        echo "  Action: Fix all clippy warnings before committing."
        ERRORS=$((ERRORS + 1))
    }
    [ $ERRORS -eq 0 ] || true
    if cargo clippy -- -D warnings > /dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    fi
fi

# ─────────────────────────────────────────────────────────────────────
# CHECK 5: Tests (cargo test)
# ─────────────────────────────────────────────────────────────────────

if [ -n "$RUST_FILES" ]; then
    echo -n "Check: tests (cargo test)... "
    TEST_OUTPUT=$(cargo test 2>&1 | tail -30) || {
        echo -e "${RED}FAIL${NC}"
        echo "  Last 30 lines of test output:"
        echo "  $TEST_OUTPUT"
        echo "  Action: All tests must pass before committing."
        ERRORS=$((ERRORS + 1))
    }
    if cargo test > /dev/null 2>&1; then
        echo -e "${GREEN}OK${NC}"
    fi
fi

# ─────────────────────────────────────────────────────────────────────
# RESULT
# ─────────────────────────────────────────────────────────────────────

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}BLOCKED: $ERRORS check(s) failed. Commit rejected.${NC}"
    exit 1
else
    echo -e "${GREEN}All checks passed.${NC}"
    exit 0
fi
